# ─────────────────────────────────────────────────────────────────────
# ss-agents-adk environment template. Copy to .env.local + fill in.
#
# Per CLAUDE.md: NEVER edit /Users/kimsejun/Documents/GitHub/social-seeding-v2/.env
# without explicit confirmation. This file is package-local + safe to copy.
# ─────────────────────────────────────────────────────────────────────

# Vertex AI / Gemini
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=ss-v2-dev
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_API_KEY=                        # only if NOT using Vertex (else leave blank)

# App-level toggles
SS_ENVIRONMENT=dev
SS_LIVE=0                                  # 1 = call live Vertex; 0 = stub model
SS_DEFAULT_MAX_USD=0.20                    # per-invocation cap when AgentDef.max_usd unset
SS_DEFAULT_CAMPAIGN_BUDGET_USD=25.00       # per-campaign daily ceiling (D39 — $25 not $5)

# Observability
OTEL_SERVICE_NAME=ss-agents-adk
SS_OTEL_ENABLED=false                      # set true on staging/prod

# Firestore (Memory Bank backing per D15)
FIRESTORE_DATABASE=(default)
