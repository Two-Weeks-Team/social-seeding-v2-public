+ *                    it mounts first. Existing SQLite tokens self-expire in 1h.
+ *   identity_only — Identity Platform only (post T+7).
+ */
+type AuthMode = "legacy" | "dual" | "identity_only";
+
 export async function startHttp(): Promise<void> {
