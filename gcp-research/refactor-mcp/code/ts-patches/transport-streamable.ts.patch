+  // Auth migration switch — REFACTOR-MCP §4.3 dual-live, T+7 cutover.
+  const mode = (process.env.MCP_AUTH_MODE as AuthMode | undefined) ?? "dual";
+  switch (mode) {
+    case "legacy":
+      console.log("[tiktok-mcp] auth mode: legacy SQLite OAuth (D19 pending)");
+      registerOAuthRoutes(app);
+      break;
+    case "identity_only":
+      console.log("[tiktok-mcp] auth mode: Identity Platform only (D19 active)");
+      registerIdentityPlatformRoutes(app);
+      break;
+    case "dual":
+    default:
+      console.log("[tiktok-mcp] auth mode: dual (Identity Platform + SQLite fallback)");
+      // Order matters — Identity Platform owns /mcp; legacy keeps the
+      // /oauth/* endpoints alive for clients on stale SQLite-issued tokens
+      // until their 1h TTL expires (src/auth/oauth.ts:27 TOKEN_TTL_MS).
+      registerIdentityPlatformRoutes(app);
+      registerOAuthRoutes(app);
+      break;
+  }

