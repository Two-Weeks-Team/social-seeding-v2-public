{
  "type": "record",
  "name": "AgentCostRecorded",
  "namespace": "ai.socialseed.v2.agent.cost",
  "doc": "Per shared.asyncapi.yaml lines 157-170 (D36). One message per LLM call; backed by recordCost() in v2 packages/observability. cost_watch (W2) consumes per-tenant.",
  "fields": [
    { "name": "agentId",      "type": "string" },
    { "name": "tenantId",     "type": "string" },
    { "name": "campaignId",   "type": ["null", "string"], "default": null },
    { "name": "model",        "type": "string", "doc": "Examples: gemini-3.5-flash, gemini-3.1-flash-lite, gemini-3.1-flash-lite, gemini-3.1-pro-preview." },
    { "name": "inputTokens",  "type": "int" },
    { "name": "outputTokens", "type": "int" },
    { "name": "usd",          "type": "double" },
    { "name": "at",           "type": "string", "doc": "ISO-8601 date-time." }
  ]
}
