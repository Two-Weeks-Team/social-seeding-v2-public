{
  "type": "record",
  "name": "AnomalyDetected",
  "namespace": "ai.socialseed.v2.watchdog.anomaly",
  "doc": "Per shared.asyncapi.yaml lines 186-203 (D36 + D23 + D32). Published by anomaly_watch; auto-runbook subscribers consume.",
  "fields": [
    {
      "name": "signalKind",
      "type": {
        "type": "enum",
        "name": "SignalKind",
        "symbols": ["cost_spike", "latency_spike", "token_explosion", "error_rate_spike", "escalation_storm"]
      }
    },
    { "name": "tenantId",   "type": "string" },
    { "name": "agentId",    "type": "string" },
    { "name": "detectedAt", "type": "string" },
    {
