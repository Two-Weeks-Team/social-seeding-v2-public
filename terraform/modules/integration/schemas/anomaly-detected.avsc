        "type": "enum",
        "name": "AnomalySeverity",
        "symbols": ["info", "warn", "page"]
      }
    },
    { "name": "metricValue", "type": ["null", "double"], "default": null },
    { "name": "baseline",    "type": ["null", "double"], "default": null },
    { "name": "runbookId",   "type": ["null", "string"], "default": null, "doc": "Cloud Workflows auto-runbook to invoke (D32)." }
  ]
