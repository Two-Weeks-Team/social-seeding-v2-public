# ============================================================================
# social-seeding-v2 — environment
# Copy to .env.local (apps/web) and worker env. Never commit real values.
# ============================================================================

# --- Database (SHARED with v1 — see FREEZE.md §3) ---------------------------
MONGODB_URI="mongodb+srv://..."
MONGODB_DB="instarsearch"          # same DB v1 writes to

# --- Auth (NextAuth / Auth.js v5) -------------------------------------------
AUTH_SECRET=""                       # >= 32 chars
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# E2E bypass (mirrors v1 /api/auth/test-login) — only honored when AUTH_TEST_LOGIN_ENABLED=true
AUTH_TEST_LOGIN_ENABLED="false"
AUTH_TEST_LOGIN_SECRET=""

# --- LLM providers ----------------------------------------------------------
GEMINI_API_KEY=""                    # Gemini — judgment/coordinator (3.5-flash) + bulk (3.1-flash-lite) + crm.enrich analysis. D53: Gemini only.

# --- Orchestration (Inngest) ------------------------------------------------
INNGEST_EVENT_KEY=""                 # prod event key
INNGEST_SIGNING_KEY=""               # prod signing key
INNGEST_DEV="1"                      # 1 = use local Inngest Dev Server

# --- External integrations --------------------------------------------------
SS_BACKEND_URL="https://backend.socialseed.ing"   # v1 backend proxy base (TikTok info/posts); override for internal :8080
SS_BACKEND_API_KEY=""                # Static X-API-Key for backend.socialseed.ing /api/v1/user/* (fixed-key/dev). If empty, v2 mints+rotates one via /auth/login below (v1 parity)
BACKEND_DASHBOARD_EMAIL=""           # /auth/login credentials → short-lived X-API-Key (5-min cache + proactive refresh; v1 key rotation)
BACKEND_DASHBOARD_PASSWORD=""        # paired with BACKEND_DASHBOARD_EMAIL
GMAIL_PUBSUB_TOPIC=""                # Gmail push (carried from v1)
RESEND_API_KEY=""                    # bounce webhooks (carried from v1)
MODAL_CRAWL_URL="https://sgwannabe--enrichment-service-crawl.modal.run"   # CRM enrichment crawler
MODAL_HEALTH_URL="https://sgwannabe--enrichment-service-health.modal.run"
NICEPAY_CLIENT_ID=""                 # billing (carried from v1)
NICEPAY_SECRET_KEY=""

# --- Observability ----------------------------------------------------------
SENTRY_DSN=""
AGENT_TRACE_SINK="mongo"             # mongo | stdout — where per-run agent traces go
COST_ALERT_THRESHOLDS="50,100,200"   # USD soft caps (per run / per workspace / global)

# --- Feature / autonomy defaults (overridable per workspace in DB) ----------
AUTONOMY_DEFAULT_LEVEL="checkpointed"   # checkpointed | autonomous | copilot
