{
  "name": "logistics_v1",
  "description": "Tier-1 logistics — free-text → JSON address extraction. D-IDs: D23, D34 (i18n parity required).",
  "agent_spec_ref": "gs://ss-v2-agent-registry/logistics/v1.json",
  "trajectory_mode": "NONE",
  "metrics": ["structured_extract_accuracy"],
  "thresholds": {"structured_extract_accuracy": 0.95},
  "min_cases": 30,
  "field_set": ["name", "phone", "postal_code", "street", "city", "country"],
  "eval_cases": [
    {"name": "logi_en_001_us_full",  "locale": "en", "tags": ["happy"], "input": {"text": "Jane Doe, 123 Market St Apt 4B, San Francisco CA 94103, USA, 415-555-0101"}, "expected": {"name": "Jane Doe", "phone": "+14155550101", "postal_code": "94103", "city": "San Francisco", "country": "US"}},
    {"name": "logi_en_002_us_partial","locale": "en", "tags": ["edge"], "input": {"text": "Send to Brooklyn NY 11201"}, "expected": {"city": "Brooklyn", "country": "US", "postal_code": "11201", "name_missing": true}},
    {"name": "logi_en_003_uk",       "locale": "en", "tags": ["happy"], "input": {"text": "John Smith, 10 Downing Street, London SW1A 2AA, UK"}, "expected": {"postal_code": "SW1A 2AA", "country": "GB"}},
    {"name": "logi_en_004_au",       "locale": "en", "tags": ["happy"], "input": {"text": "Anna L., 1 George St, Sydney NSW 2000"}, "expected": {"country": "AU"}},
    {"name": "logi_en_005_embargo",  "locale": "en", "tags": ["compliance"], "input": {"text": "..., Tehran, Iran"}, "expected": {"escalation_expected": true, "escalation_reason": "sanctions_country"}, "notes": "EC-2.20."},
    {"name": "logi_en_006_multi_recipient", "locale": "en", "tags": ["edge"], "input": {"text": "Send to me AND to my manager Sarah"}, "expected": {"escalation_expected": true, "escalation_reason": "multi_recipient"}, "notes": "EC-2.19."},
    {"name": "logi_en_007_malformed","locale": "en", "tags": ["edge"], "input": {"text": "uhh somewhere in Cali"}, "expected": {"escalation_expected": true, "escalation_reason": "address_incomplete"}, "notes": "EC-2.18."},
    {"name": "logi_en_008_pii_dlp",  "locale": "en", "tags": ["compliance"], "input": {"text": "Jane Doe 415-555-0101 SSN 123-45-6789"}, "expected": {"dlp_redacted_fields": ["SSN"]}},
    {"name": "logi_ko_009_seoul",    "locale": "ko", "tags": ["happy"], "input": {"text": "김민지, 서울특별시 강남구 테헤란로 152, 06236"}, "expected": {"city": "서울특별시", "postal_code": "06236", "country": "KR"}},
    {"name": "logi_ko_010_busan",    "locale": "ko", "tags": ["happy"], "input": {"text": "박지훈, 부산광역시 해운대구 우동 1394, 48094"}, "expected": {"city": "부산광역시", "country": "KR"}},
    {"name": "logi_ko_011_partial",  "locale": "ko", "tags": ["edge"], "input": {"text": "서울 강남"}, "expected": {"escalation_expected": true}},
    {"name": "logi_ko_012_phone_format","locale": "ko", "tags": ["happy"], "input": {"text": "010-1234-5678"}, "expected": {"phone": "+821012345678"}},
    {"name": "logi_ko_013_old_address","locale": "ko", "tags": ["edge"], "input": {"text": "서울 강남구 역삼동 123-45 (구주소)"}, "expected": {"address_format": "legacy", "warning": "modernize"}},
    {"name": "logi_ko_014_jeju",     "locale": "ko", "tags": ["happy"], "input": {"text": "한지민, 제주특별자치도 제주시 중앙로 1, 63166"}, "expected": {"country": "KR"}},
    {"name": "logi_ja_015_tokyo",    "locale": "ja", "tags": ["happy"], "input": {"text": "山田太郎、東京都渋谷区神南1-2-3、150-0041"}, "expected": {"city": "東京都", "postal_code": "150-0041", "country": "JP"}},
    {"name": "logi_ja_016_osaka",    "locale": "ja", "tags": ["happy"], "input": {"text": "佐藤花子、大阪市北区梅田1-1-1、530-0001"}, "expected": {"country": "JP"}},
    {"name": "logi_ja_017_partial",  "locale": "ja", "tags": ["edge"], "input": {"text": "東京のどこか"}, "expected": {"escalation_expected": true}},
    {"name": "logi_ja_018_phone",    "locale": "ja", "tags": ["happy"], "input": {"text": "090-1234-5678"}, "expected": {"phone": "+819012345678"}},
    {"name": "logi_ja_019_hokkaido", "locale": "ja", "tags": ["happy"], "input": {"text": "鈴木一郎、北海道札幌市中央区大通西1-1、060-0042"}, "expected": {"country": "JP"}},
    {"name": "logi_ja_020_keigo_form","locale": "ja", "tags": ["edge"], "input": {"text": "お送り先は東京都渋谷区..."}, "expected": {"city": "東京都"}},
    {"name": "logi_zh_021_beijing",  "locale": "zh", "tags": ["happy"], "input": {"text": "李小明,北京市朝阳区建国路88号,100022"}, "expected": {"city": "北京市", "postal_code": "100022", "country": "CN"}},
    {"name": "logi_zh_022_shanghai", "locale": "zh", "tags": ["happy"], "input": {"text": "王芳,上海市浦东新区世纪大道100号,200120"}, "expected": {"country": "CN"}},
    {"name": "logi_zh_023_partial",  "locale": "zh", "tags": ["edge"], "input": {"text": "北京某处"}, "expected": {"escalation_expected": true}},
    {"name": "logi_zh_024_phone",    "locale": "zh", "tags": ["happy"], "input": {"text": "138-1234-5678"}, "expected": {"phone": "+8613812345678"}},
    {"name": "logi_zh_025_guangzhou","locale": "zh", "tags": ["happy"], "input": {"text": "陈伟,广州市天河区珠江新城,510620"}, "expected": {"country": "CN"}},
    {"name": "logi_zh_026_taiwan_separate","locale": "zh", "tags": ["edge"], "input": {"text": "台北市中山區..."}, "expected": {"country": "TW", "warning_pipl_jurisdiction": true}},
    {"name": "logi_en_027_fraud_addr","locale": "en", "tags": ["adversarial"], "input": {"text": "123 Resale Drop St"}, "expected": {"escalation_expected": true, "escalation_reason": "resale_pattern"}, "notes": "EC-2.21."},
    {"name": "logi_en_028_po_box",   "locale": "en", "tags": ["edge"], "input": {"text": "PO Box 1234, City"}, "expected": {"escalation_expected": true, "escalation_reason": "po_box_disallowed_carrier"}},
    {"name": "logi_en_029_apt_unit", "locale": "en", "tags": ["happy"], "input": {"text": "Jane, 123 Main St, Apt #4B"}, "expected": {"unit_extracted": "4B"}},
    {"name": "logi_en_030_intl_postal","locale": "en", "tags": ["edge"], "input": {"text": "..., 12 rue de Rivoli, 75001 Paris, France"}, "expected": {"country": "FR"}}
  ]
}
