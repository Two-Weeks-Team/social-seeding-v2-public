{
  "name": "conversation_v1",
  "description": "Tier-1 conversation classifier — D-IDs: D23, D37. Single Flash-Lite call, 8 reply categories.",
  "agent_spec_ref": "gs://ss-v2-agent-registry/conversation/v1.json",
  "trajectory_mode": "NONE",
  "metrics": ["classification_f1"],
  "thresholds": {"classification_f1": 0.92},
  "categories": ["interested", "rejecting", "negotiating", "ambiguous", "out_of_scope", "spam", "complaint", "unsubscribe"],
  "min_cases": 25,
  "eval_cases": [
    {"name": "conv_en_001_interested",  "locale": "en", "tags": ["happy"], "input": {"reply_text": "Sounds great, please send the product."}, "expected": {"label": "interested"}},
    {"name": "conv_en_002_rejecting",   "locale": "en", "tags": ["happy"], "input": {"reply_text": "Not a fit for my channel, thanks."}, "expected": {"label": "rejecting"}},
    {"name": "conv_en_003_negotiating", "locale": "en", "tags": ["happy"], "input": {"reply_text": "Can we discuss compensation?"}, "expected": {"label": "negotiating"}},
    {"name": "conv_en_004_ambiguous",   "locale": "en", "tags": ["edge"],  "input": {"reply_text": "Sounds cool."}, "expected": {"label": "ambiguous"}, "notes": "EC-2.14."},
    {"name": "conv_en_005_out_of_scope","locale": "en", "tags": ["edge"],  "input": {"reply_text": "Do you have an internship?"}, "expected": {"label": "out_of_scope"}},
    {"name": "conv_en_006_spam",        "locale": "en", "tags": ["adversarial"], "input": {"reply_text": "Buy crypto now click link"}, "expected": {"label": "spam"}},
    {"name": "conv_en_007_complaint",   "locale": "en", "tags": ["edge"],  "input": {"reply_text": "Stop emailing me, this is harassment."}, "expected": {"label": "complaint"}},
    {"name": "conv_en_008_unsubscribe", "locale": "en", "tags": ["compliance"], "input": {"reply_text": "Unsubscribe me from all."}, "expected": {"label": "unsubscribe"}},
    {"name": "conv_en_009_sarcasm",     "locale": "en", "tags": ["edge"],  "input": {"reply_text": "Oh yeah, totally what I always wanted."}, "expected": {"label_in": ["ambiguous", "rejecting"]}, "notes": "EC-2.16."},
    {"name": "conv_en_010_code_switch", "locale": "en", "tags": ["edge"],  "input": {"reply_text": "OK, 좋아요, send it."}, "expected": {"label": "interested"}, "notes": "EC-2.15."},
    {"name": "conv_en_011_chatbot",     "locale": "en", "tags": ["adversarial"], "input": {"reply_text": "Thank you for reaching out. As an AI assistant..."}, "expected": {"label": "spam"}, "notes": "EC-2.17."},
    {"name": "conv_ko_012_interested",  "locale": "ko", "tags": ["happy"], "input": {"reply_text": "네 좋아요, 제품 보내주세요."}, "expected": {"label": "interested"}},
    {"name": "conv_ko_013_rejecting",   "locale": "ko", "tags": ["happy"], "input": {"reply_text": "죄송해요, 제 채널엔 안 맞아요."}, "expected": {"label": "rejecting"}},
    {"name": "conv_ko_014_negotiating", "locale": "ko", "tags": ["happy"], "input": {"reply_text": "비용 협의 가능한가요?"}, "expected": {"label": "negotiating"}},
    {"name": "conv_ko_015_honorific_rejecting", "locale": "ko", "tags": ["edge"], "input": {"reply_text": "다음 기회에 부탁드립니다."}, "expected": {"label": "rejecting"}},
    {"name": "conv_ja_016_interested",  "locale": "ja", "tags": ["happy"], "input": {"reply_text": "ぜひ、送ってください。"}, "expected": {"label": "interested"}},
    {"name": "conv_ja_017_keigo_decline","locale": "ja", "tags": ["edge"], "input": {"reply_text": "申し訳ございませんが、今回は見送らせていただきます。"}, "expected": {"label": "rejecting"}},
    {"name": "conv_ja_018_negotiating", "locale": "ja", "tags": ["happy"], "input": {"reply_text": "報酬条件について教えてください。"}, "expected": {"label": "negotiating"}},
    {"name": "conv_zh_019_interested",  "locale": "zh", "tags": ["happy"], "input": {"reply_text": "好的,请寄过来。"}, "expected": {"label": "interested"}},
    {"name": "conv_zh_020_rejecting",   "locale": "zh", "tags": ["happy"], "input": {"reply_text": "对不起,不适合我的频道。"}, "expected": {"label": "rejecting"}},
    {"name": "conv_zh_021_unsubscribe", "locale": "zh", "tags": ["compliance"], "input": {"reply_text": "请将我从邮件列表中删除。"}, "expected": {"label": "unsubscribe"}},
    {"name": "conv_zh_022_negotiating", "locale": "zh", "tags": ["happy"], "input": {"reply_text": "我们可以谈一谈报酬吗?"}, "expected": {"label": "negotiating"}},
    {"name": "conv_en_023_empty",       "locale": "en", "tags": ["edge"],  "input": {"reply_text": ""}, "expected": {"label": "out_of_scope"}},
    {"name": "conv_en_024_html_injection","locale": "en", "tags": ["adversarial"], "input": {"reply_text": "<script>alert(1)</script>"}, "expected": {"label": "spam"}, "notes": "EC-1.05."},
    {"name": "conv_en_025_PIPA_revoke", "locale": "en", "tags": ["compliance"], "input": {"reply_text": "I revoke my consent under PIPA Article 22."}, "expected": {"label": "unsubscribe"}, "notes": "EC-5.01."}
  ]
}
