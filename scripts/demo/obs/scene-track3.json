{
  "_meta": {
    "purpose": "OBS Studio scene collection for Track 3 (tiktok-mcp-server) recording.",
    "authority": "implements gcp-research/demo/SCRIPT.md §4 (6-beat MCP storyboard: public MCP endpoint -> ADK orchestration -> A2A registration -> Model Armor block -> KR-gap reframing -> multi-region failover).",
    "rationale": "Track 3 is more terminal-heavy than Track 2 (curl probes, gcloud commands, regional latency loops in Beat 6). Three scenes: GCP console for Beats 1-5, a 3-pane terminal grid for Beat 6 multi-region failover, and a producer-portal-zoomed scene for the Beat 5 PENDING screenshot proof.",
    "version": "1.0",
    "obs_min_version": "30.0"
  },

  "current_scene": "GCP Console - full",
  "current_program_scene": "GCP Console - full",

  "scene_order": [
    {"name": "GCP Console - full"},
    {"name": "Terminal 3-pane regional"},
    {"name": "Producer Portal zoom"}
  ],

  "name": "social-seeding-v2-track3",

  "sources": [
    {
      "name": "Display Capture - Primary",
      "id": "display_capture",
      "versioned_id": "display_capture",
      "settings": {
        "display": 0,
        "show_cursor": true
      }
    },
    {
      "name": "Window Capture - Chrome GCP Console",
      "id": "window_capture",
      "versioned_id": "window_capture",
      "settings": {
        "owner_name": "Google Chrome",
        "window_name_pattern": "*Google Cloud Console*",
        "method": 2,
        "show_cursor": true
      }
    },
    {
      "name": "Window Capture - Producer Portal",
      "id": "window_capture",
      "versioned_id": "window_capture",
      "settings": {
        "owner_name": "Google Chrome",
        "window_name_pattern": "*Cloud Marketplace Producer Portal*",
        "method": 2,
        "show_cursor": true
      }
    },
    {
      "name": "Window Capture - Terminal us-central1",
      "id": "window_capture",
      "versioned_id": "window_capture",
      "settings": {
        "owner_name": "iTerm2",
        "window_name_pattern": "*us-central1*",
        "method": 2,
        "show_cursor": true
      }
    },
    {
      "name": "Window Capture - Terminal europe-west4",
      "id": "window_capture",
      "versioned_id": "window_capture",
      "settings": {
        "owner_name": "iTerm2",
        "window_name_pattern": "*europe-west4*",
        "method": 2,
        "show_cursor": true
      }
    },
    {
      "name": "Window Capture - Terminal asia-northeast3",
      "id": "window_capture",
      "versioned_id": "window_capture",
      "settings": {
        "owner_name": "iTerm2",
        "window_name_pattern": "*asia-northeast3*",
        "method": 2,
        "show_cursor": true
      }
    },
    {
      "name": "Audio Input - Microphone",
      "id": "coreaudio_input_capture",
      "versioned_id": "coreaudio_input_capture",
      "settings": {"device_id": "default"},
      "filters": [
        {"name": "Noise Suppression", "id": "noise_suppress_filter_v2", "settings": {"method": "rnnoise"}},
        {"name": "Compressor", "id": "compressor_filter", "settings": {"ratio": 4.0, "threshold": -18.0, "attack_time": 6, "release_time": 60, "output_gain": 0.0}},
        {"name": "Limiter", "id": "limiter_filter", "settings": {"threshold": -3.0, "release_time": 60}}
      ]
    }
  ],

